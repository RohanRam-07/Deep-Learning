import numpy as np
import matplotlib.pyplot as plt
from tensorflow.keras.datasets import mnist

# Data
(X, y), _ = mnist.load_data()
X = X.reshape(-1, 784) / 255.0

# One hot encoding
Y = np.eye(10)[y]

# Weights
W1 = np.random.randn(784, 64) * 0.01
b1 = np.zeros((1, 64))
W2 = np.random.randn(64, 10) * 0.01
b2 = np.zeros((1, 10))

sigmoid = lambda x: 1/(1+np.exp(-x))

lr = 0.1

for epoch in range(5):
    loss = 0

    for i in range(len(X)):
        x = X[i:i+1]
        target = Y[i:i+1]

        # Forward
        a1 = sigmoid(x @ W1 + b1)
        a2 = sigmoid(a1 @ W2 + b2)

        loss += -np.mean(target * np.log(a2 + 1e-8))

        # Backpropagation
        d2 = a2 - target
        dW2 = a1.T @ d2
        db2 = d2

        d1 = (d2 @ W2.T) * a1 * (1-a1)
        dW1 = x.T @ d1
        db1 = d1

        # Update
        W2 -= lr*dW2
        b2 -= lr*db2
        W1 -= lr*dW1
        b1 -= lr*db1

    print("Epoch:", epoch+1, "Loss:", loss/len(X))

# Prediction
i = 100
a1 = sigmoid(X[i:i+1] @ W1 + b1)
a2 = sigmoid(a1 @ W2 + b2)

print("Predicted:", np.argmax(a2))
print("Actual:", y[i])
